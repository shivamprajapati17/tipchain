{
  "name": "@tipchain/cli",
  "version": "0.1.0",
  "description": "TipChain CLI — deploy, manage, and monitor your creator monetization platform",
  "keywords": ["tipchain", "cli", "solana", "creator", "monetization"],
  "homepage": "https://github.com/tipchain/tipchain#readme",
  "bugs": { "url": "https://github.com/tipchain/tipchain/issues" },
  "license": "MIT",
  "author": "TipChain Contributors",
  "bin": {
    "tipchain": "./dist/index.mjs"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^13",
    "chalk": "^5",
    "ora": "^8",
    "conf": "^13"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8",
    "typescript": "^5"
  },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=20" }
}
