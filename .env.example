# ─── TipChain Environment Variables ─────────────────────────────────────────
# Copy this to .env and fill in your values

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tipchain?schema=public"

# ── Redis (optional - for caching and queues) ──────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Backend ────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL="http://localhost:3000"

# ── Solana ──────────────────────────────────────────────────────────────────
SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_NETWORK="devnet"  # devnet, mainnet-beta

# ── Wallet / Payment ───────────────────────────────────────────────────────
# Helius RPC for reliable Solana access (recommended over public RPC)
HELIUS_API_KEY=""

# Jupiter aggregator for token swaps
JUPITER_API_URL="https://quote-api.jup.ag/v6"

# ── Auth ────────────────────────────────────────────────────────────────────
# API Keys for programmatic access (future)
TIPCHAIN_API_KEY=""

# ── Storage ─────────────────────────────────────────────────────────────────
# Avatar/banner image storage
# Options: local, cloudinary, s3
STORAGE_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Notifications ──────────────────────────────────────────────────────────
# Email (Resend or SendGrid)
RESEND_API_KEY=""

# Discord webhook for admin alerts
DISCORD_WEBHOOK_URL=""

# ── Analytics ──────────────────────────────────────────────────────────────
# PostHog self-hosted or cloud
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ── Monitoring ──────────────────────────────────────────────────────────────
SENTRY_DSN=""

# ── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SOLANA_NETWORK="devnet"
NEXT_PUBLIC_SOLANA_RPC="https://api.devnet.solana.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

BACKEND_API_URL="http://localhost:4000"

# ── n8n AI Automation ──────────────────────────────────────────────────────
TIPCHAIN_API_URL="http://localhost:4000"
TIPCHAIN_API_KEY=""
MONITORED_WALLET=""
N8N_WEBHOOK_URL="http://localhost:5678"
NVIDIA_API_KEY="nvapi-..."  # Get from https://build.nvidia.com

# ── Database (Supabase - optional) ──────────────────────────────────────────
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_KEY="your_service_role_key_here"

# ── Notifications ───────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
RESEND_API_KEY=""
ADMIN_EMAIL="admin@tipchain.dev"

# ── Monitoring (optional) ───────────────────────────────────────────────────
SENTRY_DSN=""
GRAFANA_API_KEY=""
PROMETHEUS_ENDPOINT=""

# ── Docker ──────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=tipchain
