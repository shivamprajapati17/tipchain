{
  "name": "tipchain-backend",
  "version": "1.0.0",
  "description": "TipChain — Production Backend API for Creator Monetization on Solana",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "start:prod": "npx prisma db push && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx src/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "vitest run tests/api",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist logs",
    "postinstall": "prisma generate",
    "docker:build": "docker build -t tipchain-backend .",
    "docker:run": "docker run -p 4000:4000 --env-file .env tipchain-backend",
    "seed": "tsx src/seed.ts",
    "seed:clear": "tsx src/seed.ts --clear"
  },
  "dependencies": {
    "@prisma/client": "^6",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2",
    "@types/express": "^5",
    "@types/jsonwebtoken": "^9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10",
    "prisma": "^6",
    "supertest": "^7.2.2",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
