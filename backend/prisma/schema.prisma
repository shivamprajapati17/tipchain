generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Creator {
  id             String        @id @default(cuid())
  walletAddress  String        @unique @map("wallet_address")
  username       String        @unique
  bio            String        @default("")
  avatarUrl      String?       @map("avatar_url")
  socialLinks    String        @default("{}") @map("social_links")
  totalTips      BigInt        @default(0) @map("total_tips")
  supporterCount Int           @default(0) @map("supporter_count")
  createdAt      DateTime      @default(now()) @map("created_at")
  supporters     Supporter[]   @relation("CreatorSupporters")
  tipsReceived   Transaction[] @relation("ReceiverTransactions")
  transactions   Transaction[] @relation("SenderTransactions")
  apiKeys        ApiKey[]

  @@map("creators")
}

model Supporter {
  id            String  @id @default(cuid())
  walletAddress String  @map("wallet_address")
  creatorWallet String  @map("creator_wallet")
  totalTipped   BigInt  @default(0) @map("total_tipped")
  tipCount      Int     @default(0) @map("tip_count")
  creator       Creator @relation("CreatorSupporters", fields: [creatorWallet], references: [walletAddress])

  @@unique([walletAddress, creatorWallet])
  @@map("supporters")
}

model Transaction {
  id             String   @id @default(cuid())
  senderWallet   String   @map("sender_wallet")
  receiverWallet String   @map("receiver_wallet")
  amount         BigInt
  token          String   @default("SOL")
  txHash         String?  @unique @map("tx_hash")
  message        String?
  vaultId        String?  @map("vault_id") // Set when created via vault support (copy-tipping)
  createdAt      DateTime @default(now()) @map("timestamp")
  receiver       Creator  @relation("ReceiverTransactions", fields: [receiverWallet], references: [walletAddress])
  sender         Creator  @relation("SenderTransactions", fields: [senderWallet], references: [walletAddress])

  @@map("transactions")
}

model Vault {
  id             String   @id @default(cuid())
  name           String
  description    String   @default("")
  ownerWallet    String   @map("owner_wallet")
  imageUrl       String?  @map("image_url")
  category       String?
  creatorWallets String   @default("[]") @map("creator_wallets") // JSON array
  allocations    String   @default("[]") @map("allocations") // JSON array of weights
  totalTipped    BigInt   @default(0) @map("total_tipped")
  supporterCount Int      @default(0) @map("supporter_count")
  tipCount       Int      @default(0) @map("tip_count")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  supporters     VaultSupporter[]

  @@map("vaults")
}

model VaultSupporter {
  id            String   @id @default(cuid())
  vaultId       String   @map("vault_id")
  walletAddress String   @map("wallet_address")
  totalTipped   BigInt   @default(0) @map("total_tipped")
  tipCount      Int      @default(0) @map("tip_count")
  lastTipAt     DateTime @default(now()) @map("last_tip_at")

  vault         Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  @@unique([vaultId, walletAddress])
  @@map("vault_supporters")
}

model ApiKey {
  id            String   @id @default(cuid())
  creatorId     String   @map("creator_id")
  creator       Creator  @relation(fields: [creatorId], references: [id])
  name          String
  key           String   @unique
  prefix        String   @map("prefix")
  permissions   String   @default("read") // "read" | "write" | "admin"
  lastUsedAt    DateTime? @map("last_used_at")
  expiresAt     DateTime? @map("expires_at")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("api_keys")
}
