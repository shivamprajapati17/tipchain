[TEMPLATE]
# TipChain Backend — Environment Variables
# Copy this to .env and fill in your values.
# Railway users: add these to your Railway environment dashboard.

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tipchain?schema=public"

# --- Redis (optional - for caching and queues) ---
REDIS_URL="redis://localhost:6379"

# --- Server ---
PORT=4000
FRONTEND_URL="http://localhost:3000"

# --- Solana ---
SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_NETWORK="devnet"  # devnet, mainnet-beta
HELIUS_API_KEY=""
JUPITER_API_URL="https://quote-api.jup.ag/v6"

# --- Auth ---
TIPCHAIN_API_KEY=""

# --- Storage ---
STORAGE_PROVIDER="local"  # local, cloudinary, s3
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Notifications ---
RESEND_API_KEY=""
DISCORD_WEBHOOK_URL=""

# --- Analytics ---
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# --- Monitoring ---
SENTRY_DSN=""
