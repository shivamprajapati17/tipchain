{
  "name": "@tipchain/ui",
  "version": "0.1.0",
  "description": "Shared React UI component library for TipChain",
  "keywords": ["tipchain", "ui", "components", "react"],
  "homepage": "https://github.com/tipchain/tipchain#readme",
  "license": "MIT",
  "author": "TipChain Contributors",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "import": "./dist/index.mjs", "require": "./dist/index.js", "types": "./dist/index.d.ts" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external react,react-dom",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --external react,react-dom",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "tailwind-merge": "^3"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsup": "^8",
    "typescript": "^5"
  },
  "publishConfig": { "access": "public" }
}
