{
  "name": "@tipchain/analytics",
  "version": "0.1.0",
  "description": "Analytics utilities for TipChain — tracking, metrics, and reporting",
  "keywords": ["tipchain", "analytics", "metrics"],
  "homepage": "https://github.com/tipchain/tipchain#readme",
  "license": "MIT",
  "author": "TipChain Contributors",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "import": "./dist/index.mjs", "require": "./dist/index.js", "types": "./dist/index.d.ts" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8",
    "typescript": "^5"
  },
  "publishConfig": { "access": "public" }
}
